[Unit]
Description=Robot Companion AI Kiosk Service
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=alex
Group=alex
WorkingDirectory=/home/alex/Robot-Companion
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/alex/.Xauthority"
Environment="PYTHONUNBUFFERED=1"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="PATH=/home/alex/Robot-Companion/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
TimeoutStartSec=180
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X0 ] && [ -S /run/user/1000/pipewire-0 ]; do sleep 1; done'
ExecStartPre=-/usr/bin/pkill -x mpv
ExecStart=/home/alex/Robot-Companion/venv/bin/python /home/alex/Robot-Companion/main.py
Restart=on-failure
RestartSec=4
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target