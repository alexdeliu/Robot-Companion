[Unit]
Description=Robot Companion AI Kiosk Service
After=network-online.target sound.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=alex
Group=alex
WorkingDirectory=/home/alex/Robot-Companion
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/alex/.Xauthority"
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/bin/sh -c 'pkill -f "mpv --no-terminal" || true'
ExecStart=/home/alex/Robot-Companion/venv/bin/python /home/alex/Robot-Companion/main.py
Restart=on-failure
RestartSec=4
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=append:/home/alex/Robot-Companion/logs/systemd.log
StandardError=append:/home/alex/Robot-Companion/logs/systemd.log

[Install]
WantedBy=graphical.target